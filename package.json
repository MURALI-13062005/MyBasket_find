{
  "name": "mini-checkout-suite",
  "version": "1.0.0",
  "description": "Mini Checkout and Browser Test Suite built with HTML, CSS, JavaScript, and Playwright",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "ecommerce",
    "checkout",
    "playwright",
    "automated-testing",
    "testing"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
